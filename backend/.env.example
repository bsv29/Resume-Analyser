# Copy to ".env". Each value overrides the default in app/core/config.py

ALLOWED_ORIGINS=["http://localhost:5173"]

# SQLite needs no setup. For PostgreSQL use:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/shortlist
DATABASE_URL=sqlite:///./shortlist.db

# Base model from Hugging Face, or the folder of your fine-tuned model:
# EMBEDDING_MODEL=training/output/finetuned-model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

LOG_LEVEL=INFO

# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_MINUTES=1440
